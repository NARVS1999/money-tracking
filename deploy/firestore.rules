// Firestore security rules — deploy verbatim via Firebase console
// (Firestore Database -> Rules). Source: backend-schema.md Security rules
// section (lines 64-93). NFR-06: rules are the server-side enforcement
// point for uid scoping, isDefault immutability, and the integer-cents
// invariant (NFR-03). The match blocks below are byte-faithful to
// backend-schema.md — do not alter them without
// updating the schema in the same change. The incomeCategories block is
// fully expanded here and in backend-schema.md: the schema's original
// comment shorthand ("identical to expenseCategories") is NOT deploy-safe —
// a comment-only match block DENIES all access to income categories.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
match /users/{uid} {
  allow read: if resource.data.uid == request.auth.uid;
  allow delete: if resource.data.uid == request.auth.uid
                 && !resource.data.isDefault;
  allow create: if request.auth != null
                 && request.resource.data.uid == request.auth.uid
                 && request.resource.data.isDefault == false;
  allow update: if resource.data.uid == request.auth.uid
                 && request.resource.data.isDefault == resource.data.isDefault;
}

match /entries/{id} {
  allow read, update, delete: if resource.data.uid == request.auth.uid;
  allow create: if request.auth != null
                 && request.resource.data.uid == request.auth.uid
                 && request.resource.data.amountCents is int;
}

match /expenseCategories/{id} {
  allow read, update, delete: if resource.data.uid == request.auth.uid;
  allow create: if request.auth != null
                 && request.resource.data.uid == request.auth.uid;
}

match /incomeCategories/{id} {
  allow read, update, delete: if resource.data.uid == request.auth.uid;
  allow create: if request.auth != null
                 && request.resource.data.uid == request.auth.uid;
}
  }
}
